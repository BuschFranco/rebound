# Número de WhatsApp que recibe los pedidos (formato internacional, sin +, espacios ni guiones)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000
# URL pública del sitio (se usa para los links de producto dentro del mensaje)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. En local (Docker) son estos valores fijos: los muestra `npx supabase status`.
# En producción: Project Settings → API Keys de tu proyecto en supabase.com (usá la "publishable").
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Clave para /api/revalidate (refresca el catálogo al instante después de editar productos).
# Generá una larga y aleatoria, por ejemplo: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVALIDATE_SECRET=cambiar-por-una-clave-larga
