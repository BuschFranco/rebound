# Número de WhatsApp que recibe los pedidos (formato internacional, sin +, espacios ni guiones)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000
# URL pública del sitio (links de producto dentro del mensaje). En tu PC: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: proyecto en la nube (Project Settings → API Keys → "publishable").
# Para la base local con Docker: http://127.0.0.1:54321 y la clave que muestra `npx supabase status`.
SUPABASE_URL=https://ryzwqsbbfqjzcyqykglp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave para /api/revalidate (refresca el catálogo al instante después de editar).
# La misma en .env.local, admin/.env y Netlify. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVALIDATE_SECRET=cambiar-por-una-clave-larga
