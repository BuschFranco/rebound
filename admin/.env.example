# Panel de administración de REBOUND. Copiá este archivo como admin/.env y completalo.
# admin/.env NO se sube a git: la secret key da acceso total a la base.

# URL del proyecto de Supabase. En local (Docker): http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# Secret key (saltea los permisos de solo lectura del sitio). NUNCA la pongas en el sitio ni en Netlify.
# En local: `npx supabase status` -> SECRET_KEY. En la nube: Project Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=

# Sitio al que se le avisa que refresque el catálogo al guardar (mismo REVALIDATE_SECRET que el sitio).
# Si se dejan vacíos, se toman de ../.env.local. Sin esto, los cambios se ven igual en menos de 1 minuto.
SITE_URL=http://localhost:3000
REVALIDATE_SECRET=
